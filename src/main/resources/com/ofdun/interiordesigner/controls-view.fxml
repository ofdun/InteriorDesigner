<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox alignment="TOP_CENTER" fillWidth="true" spacing="10.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.ofdun.interiordesigner.controllers.ControlsController">

    <ListView fx:id="objectsListView" prefHeight="150" VBox.vgrow="SOMETIMES" />

    <HBox alignment="CENTER" spacing="10.0">
        <Button fx:id="objectAddButton" maxWidth="Infinity" mnemonicParsing="false" onAction="#onObjectAddButton" text="Добавить" HBox.hgrow="ALWAYS" />
        <Button maxWidth="Infinity" mnemonicParsing="false" onAction="#onObjectRemoveButton" text="Удалить" HBox.hgrow="ALWAYS" />
    </HBox>

    <Text text="Перемещение объекта" />
    <HBox alignment="CENTER" spacing="10.0">
        <VBox alignment="CENTER" spacing="5.0">
            <Text text="X" />
            <Button maxWidth="Infinity" onAction="#onObjectXPlusButtonPressed" text="+" />
            <Button maxWidth="Infinity" onAction="#onObjectXMinusButtonPressed" text="-" />
        </VBox>
        <VBox alignment="CENTER" spacing="5.0">
            <Text text="Y" />
            <Button maxWidth="Infinity" onAction="#onObjectYPlusButtonPressed" text="+" />
            <Button maxWidth="Infinity" onAction="#onObjectYMinusButtonPressed" text="-" />
        </VBox>
        <VBox alignment="CENTER" spacing="5.0">
            <Text text="Z" />
            <Button maxWidth="Infinity" onAction="#onObjectZPlusButtonPressed" text="+" />
            <Button maxWidth="Infinity" onAction="#onObjectZMinusButtonPressed" text="-" />
        </VBox>
    </HBox>

    <Text text="Поворот объекта" />
    <HBox alignment="CENTER" spacing="10.0">
        <VBox alignment="CENTER" spacing="5.0">
            <Text text="X" />
            <Button maxWidth="Infinity" onAction="#onObjectXAnglePlusButtonPressed" text="+" />
            <Button maxWidth="Infinity" onAction="#onObjectXAngleMinusButtonPressed" text="-" />
        </VBox>
        <VBox alignment="CENTER" spacing="5.0">
            <Text text="Y" />
            <Button maxWidth="Infinity" onAction="#onObjectYAnglePlusButtonPressed" text="+" />
            <Button maxWidth="Infinity" onAction="#onObjectYAngleMinusButtonPressed" text="-" />
        </VBox>
        <VBox alignment="CENTER" spacing="5.0">
            <Text text="Z" />
            <Button maxWidth="Infinity" onAction="#onObjectZAnglePlusButtonPressed" text="+" />
            <Button maxWidth="Infinity" onAction="#onObjectZAngleMinusButtonPressed" text="-" />
        </VBox>
    </HBox>

    <Text text="Масштабирование объекта" />
    <HBox alignment="CENTER" spacing="10.0">
            <Button maxWidth="Infinity" onAction="#onObjectScalePlusButtonPressed" text="+" />
            <Button maxWidth="Infinity" onAction="#onObjectScaleMinusButtonPressed" text="-" />
    </HBox>

    <VBox fillWidth="true" spacing="10.0">
        <padding>
            <Insets bottom="10" left="10" right="10" top="10" />
        </padding>
      <Label text="Источник света" />
      <ChoiceBox fx:id="objectChoiceBox" prefWidth="150.0" />
        <HBox alignment="CENTER_LEFT" spacing="10.0">
            <Label text="Интенсивность:" />
            <Slider fx:id="lightIntensitySlider" blockIncrement="0.1" max="1.0" min="0.3" value="1.0" HBox.hgrow="ALWAYS" />
        </HBox>
    </VBox>

    <VBox fillWidth="true" spacing="10.0">
        <padding>
            <Insets bottom="10" left="10" right="10" top="10" />
        </padding>
        <Label text="Room Colors" />
        <HBox alignment="CENTER_LEFT" spacing="10.0">
            <Label text="Стены:" />
            <ColorPicker fx:id="wallsColorPicker" />
        </HBox>
        <HBox alignment="CENTER_LEFT" spacing="10.0">
            <Label text="Пол:" />
            <ColorPicker fx:id="floorColorPicker" />
        </HBox>
        <HBox alignment="CENTER_LEFT" spacing="10.0">
            <Label text="Потолок:" />
            <ColorPicker fx:id="ceilingColorPicker" />
        </HBox>
    </VBox>

    <VBox fillWidth="true" spacing="10.0">
        <padding>
            <Insets bottom="10" left="10" right="10" top="10" />
        </padding>
        <Label text="Размеры комнаты" />
        <HBox alignment="CENTER_LEFT" spacing="10.0">
            <Label text="Ширина:" minWidth="50" />
            <TextField fx:id="roomWidthField" prefWidth="80" text="100" />
        </HBox>
        <HBox alignment="CENTER_LEFT" spacing="10.0">
            <Label text="Глубина:" minWidth="50" />
            <TextField fx:id="roomDepthField" prefWidth="80" text="100" />
        </HBox>
        <HBox alignment="CENTER_LEFT" spacing="10.0">
            <Label text="Высота:" minWidth="50" />
            <TextField fx:id="roomHeightField" prefWidth="80" text="100" />
        </HBox>
        <Button fx:id="applyRoomSizeButton" onAction="#onApplyRoomSizeButtonPressed" text="Применить" />
    </VBox>

</VBox>
